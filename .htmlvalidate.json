{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "long-title": "off",
    "doctype-style": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "void-style": "off",
    "no-redundant-role": "off",
    "prefer-native-element": "off",
    "require-sri": "off",
    "no-style-tag": "off",
    "svg-focusable": "off",
    "text-content": "off",
    "no-raw-characters": "off",
    "unique-landmark": "off",
    "tel-non-breaking": "off",
    "wcag/h32": "off"
  }
}
